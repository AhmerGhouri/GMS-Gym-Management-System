{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "webpack": true,
    "deleteOutDir": true,
    "plugins": [
      "@nestjs/swagger"
    ],
    "assets": [],
    "manualRestart": false,
    "builder": {
      "type": "webpack",
      "options": {
        "externals": {
          "exclude": [
            "@gms/utils"
          ]
        }
      }
    }
  }
}